# -*- coding: utf-8 -*-
"""
SMBS_AnnotateBends.FCMacro - FreeCAD macro: annotate flat pattern with bend sequence numbers (S.18b).

Install:
  1. Copy this file to FreeCAD macros directory (Macro → Macros... → Add).
  2. Edit SMBS_REPO_PATH below to point to your SMBS_BendSeq checkout.
  3. Open FreeCAD, run Macro → SMBS_AnnotateBends → Execute.
  4. Select run directory (runs/run_XXX/) containing 04/07/flat_pattern.brep.

Honest marking:
  - green  = VERIFIED (production_eligible=true)
  - orange = VERIFICATION_FAILED (e.g., KL-8 tooling collision — order is correct, verification cannot confirm)
  - gray   = UNVERIFIED (no 09_verification_result.json)
"""

# ==== USER CONFIG (edit this line) ====
SMBS_REPO_PATH = r"/Users/badmc/Desktop/SMBS_BendSeq"
TEXT_HEIGHT_MM = 5.0
# ======================================

import sys
from pathlib import Path

import FreeCAD as App
import FreeCADGui as Gui
import Part
import Draft
from PySide6 import QtWidgets


def _fail(msg: str) -> None:
    App.Console.PrintError(f"SMBS: {msg}\n")
    QtWidgets.QMessageBox.critical(None, "SMBS: Annotate Bends", msg)


def _info(msg: str) -> None:
    App.Console.PrintMessage(f"SMBS: {msg}\n")
    QtWidgets.QMessageBox.information(None, "SMBS: Annotate Bends", msg)


def _color_for_verification(verification: str):
    if verification == "VERIFIED":
        return (0.0, 0.6, 0.0)       # green
    if verification == "VERIFICATION_FAILED":
        return (1.0, 0.5, 0.0)       # orange
    return (0.5, 0.5, 0.5)           # gray (UNVERIFIED)


def run_macro() -> None:
    # 1. Validate repo path
    repo = Path(SMBS_REPO_PATH)
    if not repo.is_dir():
        _fail(
            f"SMBS_REPO_PATH is not a directory: {SMBS_REPO_PATH}\n\n"
            f"Edit SMBS_AnnotateBends.FCMacro and set SMBS_REPO_PATH "
            f"to your SMBS_BendSeq checkout."
        )
        return

    if str(repo) not in sys.path:
        sys.path.insert(0, str(repo))

    # 2. Import viewer modules (after sys.path set)
    try:
        from smbs_core.viewer.run_loader import load_run, RunLoaderError
        from smbs_core.viewer.graph_builder import build_graphs, GraphBuilderError
        from smbs_core.viewer.flat_annotations import (
            compute_annotations,
            FlatAnnotationsError,
            VERIFICATION_VERIFIED,
            VERIFICATION_FAILED,
            VERIFICATION_UNVERIFIED,
        )
    except ImportError as e:
        _fail(f"Cannot import smbs_core.viewer from {SMBS_REPO_PATH}: {e}")
        return

    # 3. Select run directory
    run_dir_str = QtWidgets.QFileDialog.getExistingDirectory(
        None,
        "Select SMBS run directory (contains 04/07/*.brep)",
        str(repo / "runs"),
    )
    if not run_dir_str:
        _info("Cancelled.")
        return
    run_dir = Path(run_dir_str)

    # 4. Load artifacts
    try:
        artifacts = load_run(run_dir)
    except RunLoaderError as e:
        _fail(f"Cannot load run: {e}")
        return

    try:
        graphs = build_graphs(artifacts)
    except GraphBuilderError as e:
        _fail(f"Cannot build graphs: {e}")
        return

    # 5. Compute annotations (strict; will raise on old runs without bend_line_flat_pattern)
    try:
        annotations = compute_annotations(artifacts, graphs)
    except FlatAnnotationsError as e:
        _fail(f"Cannot compute annotations:\n\n{e}")
        return

    if not annotations:
        _info("No annotations (empty candidate_sequence in 07_search_result.json).")
        return

    # 6. Load flat pattern into current document
    if artifacts.flat_pattern_path is None:
        _fail(
            "flat_pattern.brep not found in run directory.\n\n"
            "Cannot display annotations without flat pattern. "
            f"Expected: {run_dir / 'flat_pattern.brep'}"
        )
        return

    try:
        flat_shape = Part.Shape()
        flat_shape.read(str(artifacts.flat_pattern_path))
    except Exception as e:
        _fail(f"Cannot read flat_pattern.brep: {e}")
        return

    # Ensure active document exists
    if App.ActiveDocument is None:
        App.newDocument("SMBS_FlatPattern")
        Gui.ActiveDocument = Gui.activeDocument()  # may be no-op on headless

    try:
        flat_obj = Part.show(flat_shape, "SMBS_FlatPattern")
    except Exception as e:
        _fail(f"Cannot display flat pattern: {e}")
        return

    # 7. Create text annotations
    verification = annotations[0].verification  # run-level, same for all
    color = _color_for_verification(verification)
    created = 0
    for ann in annotations:
        try:
            placement = App.Placement(
                App.Vector(*ann.midpoint),
                App.Rotation()
            )
            text_obj = Draft.make_text(
                string=str(ann.step),
                placement=placement,
                screen=True,               # always faces camera
                height=TEXT_HEIGHT_MM,
            )
            text_obj.Label = f"SMBS_step_{ann.step:03d}_{ann.bend_id}"
            if text_obj.ViewObject is not None:
                text_obj.ViewObject.TextColor = color
            created += 1
        except Exception as e:
            _fail(f"Failed to create annotation for step {ann.step} ({ann.bend_id}): {e}")
            return

    try:
        App.ActiveDocument.recompute()
    except Exception as e:
        App.Console.PrintWarning(f"SMBS: recompute warning: {e}\n")

    # 8. Final summary message
    diags = artifacts.verification_result.get("diagnostics", []) if artifacts.verification_result else []
    diag_preview = ""
    if diags:
        preview_items = []
        for d in diags[:3]:
            if isinstance(d, dict):
                preview_items.append(f"[{d.get('code', '?')}] {d.get('message', '')[:80]}")
            else:
                preview_items.append(str(d)[:80])
        diag_preview = "\nDiagnostics:\n  " + "\n  ".join(preview_items)
        if len(diags) > 3:
            diag_preview += f"\n  ... and {len(diags) - 3} more"

    summary = (
        f"Added {created} annotation(s).\n\n"
        f"Verification: {verification}\n"
        f"Steps: {', '.join(str(a.step) for a in annotations)}{diag_preview}"
    )
    _info(summary)


if __name__ == "__main__":
    run_macro()
