{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smbs://contracts/verification_result.schema.json",
  "title": "VerificationResult",
  "description": "Independent verifier result with Hausdorff, volume and B-Rep invariants (§5.3, §7.1)",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "part_id",
    "input_fingerprint",
    "producer",
    "units",
    "frame_convention",
    "status",
    "payload",
    "diagnostics",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_name": { "const": "verification_result" },
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "part_id": { "type": "string" },
    "input_fingerprint": { "type": "string" },
    "producer": { "type": "object" },
    "units": { "type": "string", "enum": ["mm", "m", "in"] },
    "frame_convention": { "type": "string" },
    "status": { "type": "string" },
    "diagnostics": { "type": "array" },
    "created_at": { "type": "string" },
    "content_hash": { "type": "string" },
    "payload": {
      "type": "object",
      "required": [
        "verification_status",
        "verification_independence_level",
        "production_eligible",
        "step_verifications",
        "independent_metrics"
      ],
      "properties": {
        "verification_status": {
          "type": "string",
          "enum": ["VERIFIED", "VERIFICATION_FAILED"]
        },
        "verification_independence_level": {
          "type": "string"
        },
        "production_eligible": {
          "type": "boolean"
        },
        "step_verifications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "bend_id", "status"],
            "properties": {
              "step": { "type": "integer" },
              "bend_id": { "type": "string" },
              "status": { "type": "string", "enum": ["VERIFIED", "VERIFICATION_FAILED"] },
              "collision_verified": { "type": "boolean" },
              "kinematics_verified": { "type": "boolean" }
            }
          }
        },
        "independent_metrics": {
          "type": "object",
          "required": [
            "is_valid_brep",
            "solids_count",
            "shells_count",
            "volume_delta_mm3",
            "relative_volume_delta",
            "surface_area_delta_mm2",
            "hausdorff_distance_mm",
            "bbox_delta_mm"
          ],
          "properties": {
            "is_valid_brep": { "type": "boolean" },
            "solids_count": { "type": "integer" },
            "shells_count": { "type": "integer" },
            "volume_delta_mm3": { "type": "number" },
            "relative_volume_delta": { "type": "number" },
            "surface_area_delta_mm2": { "type": "number" },
            "hausdorff_distance_mm": { "type": "number" },
            "bbox_delta_mm": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    }
  }
}
