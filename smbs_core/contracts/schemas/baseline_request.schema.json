{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "smbs://contracts/baseline_request.schema.json",
  "title": "BaselineRequest",
  "description": "Request for Stage 1 Baseline verification: unfold -> align full frame -> fold all -> compare (§5.1)",
  "type": "object",
  "required": [
    "schema_name",
    "schema_version",
    "run_id",
    "part_id",
    "input_fingerprint",
    "producer",
    "units",
    "frame_convention",
    "status",
    "payload",
    "diagnostics",
    "created_at",
    "content_hash"
  ],
  "properties": {
    "schema_name": { "const": "baseline_request" },
    "schema_version": { "type": "string" },
    "run_id": { "type": "string" },
    "part_id": { "type": "string" },
    "input_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "producer": { "type": "object" },
    "units": { "type": "string", "enum": ["mm", "m", "in"] },
    "frame_convention": { "type": "string" },
    "status": { "type": "string" },
    "diagnostics": { "type": "array" },
    "created_at": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "payload": {
      "type": "object",
      "required": [
        "geometry_result_ref",
        "canonical_part_ref",
        "tolerance_profile"
      ],
      "properties": {
        "geometry_result_ref": {
          "type": "object",
          "required": ["file_path", "content_hash"],
          "properties": {
            "file_path": { "type": "string" },
            "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "canonical_part_ref": {
          "type": "object",
          "required": ["file_path", "content_hash"],
          "properties": {
            "file_path": { "type": "string" },
            "content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "tolerance_profile": {
          "type": "object",
          "required": [
            "linear_tol_mm",
            "angular_tol_deg",
            "volume_tol_mm3",
            "relative_volume_tol",
            "surface_distance_tol_mm",
            "bbox_tol_mm"
          ],
          "properties": {
            "linear_tol_mm": { "type": "number", "minimum": 0 },
            "angular_tol_deg": { "type": "number", "minimum": 0 },
            "volume_tol_mm3": { "type": "number", "minimum": 0 },
            "relative_volume_tol": { "type": "number", "minimum": 0 },
            "surface_distance_tol_mm": { "type": "number", "minimum": 0 },
            "bbox_tol_mm": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
