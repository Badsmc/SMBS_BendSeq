runs/
*.tmp
test_output.json
restored_*.brep
**/.DS_Store

# PressBrakeSim 2.5D generated artifacts (original demo .FCStd stays trackable)
reports/
pressbrake_traces/
*.jsonl
*.summary.json
*.FCStd.bak
.smbs_repo_path
SMBS_demo_FCStd_17_files.zip

# Local punch/die models and metadata must not be committed.
/toollibrary/punch/*
!/toollibrary/punch/.gitkeep
/toollibrary/die/*
!/toollibrary/die/.gitkeep
/demo/legacy-tooling/punch/
/demo/legacy-tooling/die/
/demo/legacy-tooling/sets/

# User libraries live outside the checkout; never publish local migration data.
/toollibrary/
/config/
/saved_sequences/
/migration-conflicts/
/migration-v1.json
/freecad/bendseq/resources/default_toollibrary/punch/*
!/freecad/bendseq/resources/default_toollibrary/punch/.gitkeep
/freecad/bendseq/resources/default_toollibrary/die/*
!/freecad/bendseq/resources/default_toollibrary/die/.gitkeep
