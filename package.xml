<?xml version="1.0" encoding="UTF-8"?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>SMBS BendSeq</name>
  <description>PressBrakeSim workbench for sheet-metal bend sequence planning, tooling setup, 3D simulation, and sampled collision checks. Development preview. See LICENSE.md for CAD asset provenance.</description>
  <version>0.2.0</version>
  <date>2026-11-26</date>
  <maintainer email="109237230+Badsmc@users.noreply.github.com">Badsmc</maintainer>
  <license file="LICENSE-Code">LGPL-2.1-or-later</license>
  <license file="LICENSE-Assets">CC-BY-SA-4.0</license>
  <url type="repository" branch="develop">https://github.com/Badsmc/SMBS_BendSeq</url>
  <url type="readme">https://github.com/Badsmc/SMBS_BendSeq/raw/develop/README.md</url>
  <url type="bugtracker">https://github.com/Badsmc/SMBS_BendSeq/issues</url>
  <icon>freecad/bendseq/resources/icons/gui_workbench.svg</icon>
  <freecadmin>1.1.3</freecadmin>
  <pythonmin>3.11</pythonmin>
  <tag>Sheet metal</tag>
  <tag>Press brake</tag>
  <tag>Simulation</tag>
  <content>
    <workbench>
      <name>PressBrakeSim</name>
      <icon>freecad/bendseq/resources/icons/gui_workbench.svg</icon>
      <classname>SMBSWorkbench</classname>
      <subdirectory>./</subdirectory>
      <depend type="addon" optional="true">SheetMetal Workbench</depend>
      <depend type="internal">part</depend>
      <depend type="internal" optional="true">techdraw</depend>
    </workbench>
  </content>
</package>
